{
	// Fixture for TestEvaluateLintGolden. Each grant/definition below is chosen
	// to trigger exactly one class of lint finding (or none, for the clean cases)
	// so the golden pins every check.
	"groups": {
		"group:dev": ["alice@example.com"],
		"group:unused": ["bob@example.com"], // referenced by nothing -> unused-group
	},
	"hosts": {
		"web": "100.64.0.10",
		"legacy": "100.64.0.20", // referenced by nothing -> unused-host
	},
	"ipsets": {
		"ipset:corp": ["10.0.0.0/8"], // referenced by grants[4] -> used
	},
	"tagOwners": {
		"tag:web": ["group:dev"],
		"tag:db": ["group:dev"],
		"tag:orphan": ["group:dev"], // referenced by nothing -> unused-tag
	},
	"acls": [
		// legacy ACL with an undefined source group (tag:db keeps that tag "used")
		{"action": "accept", "src": ["group:missing2"], "dst": ["tag:db:5432"]},
	],
	"grants": [
		// 0: clean, no findings
		{"src": ["group:dev"], "dst": ["tag:web:443"], "ip": ["tcp:443"]},
		// 1: undefined source group + destination tag with no owner
		{"src": ["group:missing"], "dst": ["tag:noowner:443"], "ip": ["tcp:443"]},
		// 2: any-to-any wildcard
		{"src": ["*"], "dst": ["*:443"], "ip": ["tcp:443"]},
		// 3: exact duplicate of grant 0
		{"src": ["group:dev"], "dst": ["tag:web:443"], "ip": ["tcp:443"]},
		// 4: references ipset:corp and host web, keeping both "used"
		{"src": ["ipset:corp"], "dst": ["web:22"], "ip": ["tcp:22"]},
		// 5: undefined host alias in the destination
		{"src": ["group:dev"], "dst": ["typo-host:80"], "ip": ["tcp:80"]},
		// 6: empty destination -> dead grant
		{"src": ["group:dev"], "dst": [], "ip": ["tcp:443"]},
	],
}
